# Gmail Email Scraper - Environment Variables
# Usage:
#   cp .env.example .env
#   Edit .env and fill in your credentials
#   source .env && python gmail_scraper.py

# Gmail account (full email address)
export GMAIL_USER=""

# Gmail App Password (NOT your Gmail login password)
# Must be generated in your Google Account security settings:
# https://myaccount.google.com/apppasswords
# Prerequisite: 2-Step Verification must be enabled.
export GMAIL_PASSWORD=""

# OpenRouter API key
# Get yours at: https://openrouter.ai/keys
export OPENROUTER_API_KEY=""

# OpenRouter model used for source understanding + Tavily-result selection.
export SOURCE_SEARCH_MODEL="qwen/qwen3.7-plus"
export SOURCE_SEARCH_FALLBACK_MODEL="qwen/qwen3.7-plus"
# JSON-only source extraction and selection do not need long generations.
export SOURCE_SEARCH_MAX_TOKENS="600"
export SOURCE_SEARCH_REASONING_EFFORT="none"

# Tavily API key used to search for authoritative news sources.
# Get one at: https://app.tavily.com/home
export TAVILY_API_KEY=""
export SOURCE_MIN_CONFIDENCE="0.75"

# Optional: vision model used to read uploaded screenshots.
export MANUAL_VISION_MODEL="google/gemini-2.5-flash"
